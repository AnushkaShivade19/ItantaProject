    "apis": [
      {
        "method": "POST",
        "path": "/api/notes",
        "purpose": "create a new note",
        "request": {
          "title": "string",
          "content": "string",
          "tags": "array<string>"
        },
        "response": {
          "id": "string",
          "title": "string",
          "content": "string",
          "tags": "array<string>"
        }
      },
      {
        "method": "GET",
        "path": "/api/notes",
        "purpose": "get all notes",
        "response": {
          "notes": "array<{id: string, title: string, content: string, tags: array<string>}>"
        }
      },
      {
        "method": "GET",
        "path": "/api/notes/{note_id}",
        "purpose": "get a note by id",
        "response": {
          "id": "string",
          "title": "string",
          "content": "string",
          "tags": "array<string>"
        }
      },
      {
        "method": "PUT",
        "path": "/api/notes/{note_id}",
        "purpose": "update a note",
        "request": {
          "title": "string?",
          "content": "string?",
          "tags": "array<string>?"
        },
        "response": {
          "id": "string",
          "title": "string",
          "content": "string",
          "tags": "array<string>"
        }
      },
      {
        "method": "DELETE",
        "path": "/api/notes/{note_id}",
        "purpose": "delete a note",
        "response": {
          "message": "string"
        }
      },
      {
        "method": "GET",
        "path": "/api/notes/search",
        "purpose": "search notes by title",
        "request": {
          "query": "string"
        },
        "response": {
          "notes": "array<{id: string, title: string, content: string, tags: array<string>}>"
        }
      },
      {
        "method": "GET",
        "path": "/api/notes/tags/{tag}",
        "purpose": "get notes by tag",
        "response": {
          "notes": "array<{id: string, title: string, content: string, tags: array<string>}>"
        }
      }
    ],
    "db_schema": [
